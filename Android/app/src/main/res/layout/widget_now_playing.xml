<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing widget (NowPlayingWidget.views): cover, song, previous / play-pause / next.
     Also the picker's preview (previewLayout), with the placeholder texts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:clipToOutline="true"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="8dp">

  <ImageView
    android:id="@+id/widget_cover"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:contentDescription="@string/widget_cover"
    android:scaleType="centerCrop"
    android:src="@drawable/widget_cover_placeholder" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_preview_title"
      android:textColor="#FFF5E8"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_preview_artist"
      android:textColor="#B3A99B"
      android:textSize="13sp" />
  </LinearLayout>

  <ImageButton
    android:id="@+id/widget_previous"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/widget_previous"
    android:src="@drawable/widget_previous" />

  <ImageButton
    android:id="@+id/widget_toggle"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/widget_play"
    android:src="@drawable/widget_play" />

  <ImageButton
    android:id="@+id/widget_next"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/widget_next"
    android:src="@drawable/widget_next" />
</LinearLayout>
