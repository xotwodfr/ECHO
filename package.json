{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "description": "ECHO: an immersive, self-hosted music player for Navidrome and Spotify",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "node --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:hardware": "node scripts/verify-hardware.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@material/material-color-utilities": "0.4.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "sharp": "0.35.5",
    "youtubei.js": "18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  }
}
