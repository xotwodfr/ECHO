# Local development settings (copy to .env.local or export in your shell; never commit real values).
# The container takes the same variables from compose.yaml. Secrets never go here: the master key
# is a Docker secret file (compose.example.yaml).

# Public origin, scheme://host[:port] with no path. Optional in M1, required for the Host/Origin checks in M5.
ECHO_PUBLIC_ORIGIN=https://echo.example.com
# Port the server listens on (inside the container: 8080). Pick a free one if 8080 is taken locally.
ECHO_PORT=8080
# debug | info | warn | error
ECHO_LOG=info
