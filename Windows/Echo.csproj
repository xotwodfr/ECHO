<Project Sdk="Microsoft.NET.Sdk">

  <!-- ECHO for Windows: WPF on .NET 10 with Windows 11's Fluent theme (README.md). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ECHO</AssemblyName>
    <RootNamespace>Echo</RootNamespace>
    <!-- Builds (not runs) on Linux and macOS too: the WPF reference assemblies come from NuGet. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Application.ThemeMode (the Fluent theme) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
