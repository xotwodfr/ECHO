<Project Sdk="Microsoft.NET.Sdk">

  <!-- ECHO for Windows: Avalonia on .NET 10, liquid glass (README.md;
       docs/superpowers/specs/2026-11-06-windows-glass-design.md). The plain net10.0 target runs on
       the Linux dev box and in the tests; the Windows target is the released ECHO.exe (SMTC). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ECHO</AssemblyName>
    <RootNamespace>Echo</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SoundFlow" Version="1.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Glass/glass.sksl" LogicalName="glass.sksl" />
    <!-- The room's shaders are Android's assets, which are the web's (ShaderTests). -->
    <EmbeddedResource Include="../../Android/app/src/main/assets/stage/*.glsl" LogicalName="stage.%(Filename).glsl" />
    <EmbeddedResource Include="../../Android/app/src/main/res/drawable-nodpi/blue_noise_64.png" LogicalName="stage.blue_noise_64.png" />
    <InternalsVisibleTo Include="Echo.Tests" />
  </ItemGroup>

</Project>
