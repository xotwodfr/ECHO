<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Echo.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <!-- Quiet tools (PRODUCT_SPEC.md §1.1): Fluent's controls in a light neutral, not Windows' blue. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFE6E3DD" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ECHO/Ui/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
