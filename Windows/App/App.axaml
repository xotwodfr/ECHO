<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Echo.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <!-- Fluent's own controls (text boxes, sliders, menus) take Cider's key colour. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFFC3C44" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://ECHO/Ui/CiderStyles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ECHO/Ui/Cider.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
