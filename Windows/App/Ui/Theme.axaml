<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ECHO's dark neutrals (DESIGN_SYSTEM.md §3); colour comes from the playing album, not from here. -->
  <Color x:Key="GroundColor">#0B0B10</Color>
  <Color x:Key="Surface1Color">#15151C</Color>
  <SolidColorBrush x:Key="Ground" Color="{StaticResource GroundColor}" />
  <SolidColorBrush x:Key="Surface1" Color="{StaticResource Surface1Color}" />
  <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Muted" Color="#99FFFFFF" />
  <SolidColorBrush x:Key="Focus" Color="#FFFFFF" />
  <!-- The web's font token; Inter (bundled with Avalonia) where Windows' faces are missing: the dev box. -->
  <FontFamily x:Key="EchoFont">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter</FontFamily>
  <!-- Icons, 24×24 (Fluent System Icons' shapes, filled). -->
  <StreamGeometry x:Key="IconPlay">M7 4.6v14.8c0 .8.9 1.3 1.6.9l11.5-7.4c.6-.4.6-1.3 0-1.7L8.6 3.7C7.9 3.3 7 3.8 7 4.6Z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M6.5 4h3c.8 0 1.5.7 1.5 1.5v13c0 .8-.7 1.5-1.5 1.5h-3C5.7 20 5 19.3 5 18.5v-13C5 4.7 5.7 4 6.5 4Zm8 0h3c.8 0 1.5.7 1.5 1.5v13c0 .8-.7 1.5-1.5 1.5h-3c-.8 0-1.5-.7-1.5-1.5v-13c0-.8.7-1.5 1.5-1.5Z</StreamGeometry>
  <StreamGeometry x:Key="IconPrevious">M5 5c.6 0 1 .4 1 1v12c0 .6-.4 1-1 1s-1-.4-1-1V6c0-.6.4-1 1-1Zm14.4.2c.6-.4 1.6 0 1.6.8v12c0 .8-1 1.2-1.6.8l-9-6c-.6-.4-.6-1.2 0-1.6l9-6Z</StreamGeometry>
  <StreamGeometry x:Key="IconNext">M19 5c.6 0 1 .4 1 1v12c0 .6-.4 1-1 1s-1-.4-1-1V6c0-.6.4-1 1-1ZM4.6 5.2C4 4.8 3 5.2 3 6v12c0 .8 1 1.2 1.6.8l9-6c.6-.4.6-1.2 0-1.6l-9-6Z</StreamGeometry>
  <StreamGeometry x:Key="IconBack">M15.7 4.3c.4.4.4 1 0 1.4L9.4 12l6.3 6.3c.4.4.4 1 0 1.4s-1 .4-1.4 0l-7-7c-.4-.4-.4-1 0-1.4l7-7c.4-.4 1-.4 1.4 0Z</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M10 3a7 7 0 0 1 5.6 11.2l4.6 4.6c.4.4.4 1 0 1.4s-1 .4-1.4 0l-4.6-4.6A7 7 0 1 1 10 3Zm0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z</StreamGeometry>

  <!-- Buttons on glass: no chrome of their own, a faint light on hover. -->
  <ControlTheme x:Key="Bare" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
