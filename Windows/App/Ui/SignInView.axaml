<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Echo.Ui.SignInView">
  <!-- The wordmark and one form in a 360 px column, in Cider's controls. -->
  <StackPanel Width="360" VerticalAlignment="Center" Spacing="12">
    <TextBlock Text="ECHO" FontSize="28" FontWeight="ExtraBold" LetterSpacing="8" HorizontalAlignment="Center" Margin="0,0,0,24" />
    <TextBlock x:Name="Heading" Text="Sign in" FontSize="20" FontWeight="SemiBold" />
    <StackPanel x:Name="Credentials" Spacing="12">
      <TextBox x:Name="UserBox" PlaceholderText="Username" />
      <TextBox x:Name="PasswordBox" PlaceholderText="Password" PasswordChar="•" />
    </StackPanel>
    <StackPanel x:Name="CodePanel" Spacing="6" IsVisible="False">
      <TextBox x:Name="CodeBox" PlaceholderText="Code" MaxLength="10" />
      <TextBlock Text="The 6-digit code from your authenticator app." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock x:Name="Error" Foreground="#FFB4A9" TextWrapping="Wrap" IsVisible="False" />
    <Button x:Name="SubmitButton" Content="Sign in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Theme="{StaticResource CiderButton}" Classes="primary" FontWeight="SemiBold" IsDefault="True" />
  </StackPanel>
</UserControl>
