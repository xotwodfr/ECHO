<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Echo.Ui.MainWindow"
        Title="ECHO"
        Icon="/Assets/echo.ico"
        Width="1336" Height="768" MinWidth="1024" MinHeight="640"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Mica, None"
        Background="{DynamicResource WindowFallback}"
        Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource CiderFont}">
</Window>
