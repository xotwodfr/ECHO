<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Echo.Ui"
             x:Class="Echo.Ui.AlbumView">
  <ScrollViewer>
    <StackPanel Margin="228,72,24,110">
      <Grid ColumnDefinitions="Auto,*" Margin="8,0,0,0">
        <Border Width="240" Height="240" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Surface1}">
          <ui:CoverImage x:Name="Cover" Pixels="480" />
        </Border>
        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Bottom" Spacing="6">
          <TextBlock Text="ALBUM" FontSize="11" LetterSpacing="1.3" Foreground="{DynamicResource Muted}" />
          <TextBlock x:Name="Title" FontSize="56" FontWeight="ExtraBold" LetterSpacing="-1.1" TextWrapping="Wrap" />
          <TextBlock x:Name="Artist" FontSize="14" Foreground="{DynamicResource Muted}" />
          <Button x:Name="PlayAll" Content="Play" Margin="0,10,0,0" Height="36" Padding="20,0" CornerRadius="18"
                  Background="{DynamicResource Text}" Foreground="{DynamicResource Ground}" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" Margin="8,24,0,0" IsVisible="False" />
      <ItemsControl x:Name="Songs" Margin="0,28,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ui:SongRow">
            <Button Theme="{StaticResource Bare}" CornerRadius="8" Padding="12,9" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="Play">
              <Grid ColumnDefinitions="36,*,Auto">
                <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Song.Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Song.Artist}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
