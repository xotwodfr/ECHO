<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cider 1's .search-input, filled as today's fields are: 8 px radius, a faint white fill and hairline, the
       hairline key-coloured along the bottom when focused (as Windows 11's), #c8c8c8 at 500, room on the left
       for the magnifier. -->
  <Style Selector="TextBox.search, TextBox.field">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="BorderBrush" Value="#14FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="#C8C8C8" />
    <Setter Property="Padding" Value="32,6,6,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement, TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement, TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#991E1E1E" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#1FFFFFFF" />
        <GradientStop Offset="0.95" Color="#1FFFFFFF" />
        <GradientStop Offset="0.96" Color="#FC3C44" />
        <GradientStop Offset="1" Color="#FC3C44" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <!-- The top bar's pill: a soft key-coloured ring when focused (a bottom line does not suit a pill). -->
  <Style Selector="TextBox.pill:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#99FC3C44" />
  </Style>
  <Style Selector="TextBox.search:focus, TextBox.field:focus">
    <Setter Property="Foreground" Value="#C8C8C8" />
  </Style>

  <!-- The sign-in form's fields: the same finish, taller, no magnifier. -->
  <Style Selector="TextBox.field">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Foreground" Value="#EEEEEE" />
  </Style>
  <Style Selector="TextBox.field:focus">
    <Setter Property="Foreground" Value="#EEEEEE" />
  </Style>

  <!-- .md-select: an md-btn that drops down. -->
  <Style Selector="ComboBox.md">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="BorderBrush" Value="#14FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#EEEEEE" />
    <Setter Property="Padding" Value="12,6,8,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ComboBox.md:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="#2EFFFFFF" />
    <Setter Property="BorderBrush" Value="#14FFFFFF" />
  </Style>

  <!-- Every menu as Cider's #cmenu: #1e1e1e-ish, a hairline, radius 10, 5 px in; the items
       radius 6 with room to breathe. -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="#262626" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="MenuItem, ComboBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- Cider's popovers and menus bring their own body. -->
  <Style Selector="FlyoutPresenter.cider">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MaxWidth" Value="400" />
  </Style>

  <!-- A press pushes a button in a little and lets it spring back (Cider 4's motion-press-scale); the
       window's own controls stay put, as Windows' do. -->
  <Style Selector="Button:not(.nopress)">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:not(.nopress):pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
</Styles>
