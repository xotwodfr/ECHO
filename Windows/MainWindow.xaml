<Window x:Class="Echo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECHO" Width="960" Height="680" MinWidth="480" MinHeight="400">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The page's bar: back to the albums, its title, sign out. -->
    <DockPanel x:Name="TopBar" Grid.Row="0" Margin="12,8" Visibility="Collapsed">
      <Button x:Name="BackButton" DockPanel.Dock="Left" Content="← Albums" Click="Back_Click" Visibility="Collapsed" />
      <Button DockPanel.Dock="Right" Content="Sign out" Click="SignOut_Click" />
      <TextBlock x:Name="PageTitle" Margin="12,0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <TextBlock x:Name="Status" Grid.Row="1" Margin="12,4" TextWrapping="Wrap" Visibility="Collapsed" />

    <!-- Sign in: the server's device token, the code in the same request when two-factor is on. -->
    <StackPanel x:Name="SignInPage" Grid.Row="2" Width="340" VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="Sign in to ECHO" />
      <TextBlock x:Name="ServerText" Margin="0,4,0,16" HorizontalAlignment="Center" Opacity="0.7" />
      <TextBlock Text="Username" />
      <TextBox x:Name="UserBox" Margin="0,4,0,12" />
      <TextBlock Text="Password" />
      <PasswordBox x:Name="PassBox" Margin="0,4,0,12" />
      <TextBlock Text="Authenticator code, if you use two-factor" />
      <TextBox x:Name="CodeBox" Margin="0,4,0,16" />
      <Button x:Name="SignInButton" Content="Sign in" IsDefault="True" Click="SignIn_Click" />
      <TextBlock x:Name="SignInMessage" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <ListBox x:Name="AlbumList" Grid.Row="2" Visibility="Collapsed" SelectionChanged="AlbumList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,6">
            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Opacity="0.7" Text="{Binding Sub}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ListBox x:Name="SongList" Grid.Row="2" Visibility="Collapsed" SelectionChanged="SongList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,6">
            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Opacity="0.7" Text="{Binding Sub}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Now playing: the song, its time, play or pause. -->
    <Border x:Name="NowBar" Grid.Row="3" Padding="12,8" BorderBrush="#33808080" BorderThickness="0,1,0,0"
            Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="ToggleButton" DockPanel.Dock="Right" Width="80" Content="Pause" Click="Toggle_Click" />
        <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock x:Name="NowText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
